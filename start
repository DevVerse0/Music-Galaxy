#!/bin/bash

# Music Galaxy Bot Startup Script
# Optimized for Railway / Docker

echo "----------------------------------------------------"
echo "  🚀 Starting Music Galaxy..."
echo "  💎 Version: 3.5.0"
echo "  🛠️ Environment: Production"
echo "----------------------------------------------------"

if ! command -v ffmpeg >/dev/null 2>&1; then
  if [ -x "$PWD/bin/ffmpeg" ]; then
    export PATH="$PWD/bin:$PATH"
  else
    echo "Downloading ffmpeg..."
    mkdir -p bin
    curl -sL https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz -o /tmp/ff.tar.xz
    tar -xf /tmp/ff.tar.xz -C bin --strip-components=1
    export PATH="$PWD/bin:$PATH"
  fi
fi

if [ -d "$PWD/bin" ]; then
  export PATH="$PWD/bin:$PATH"
fi

if ! command -v node >/dev/null 2>&1 && ! command -v deno >/dev/null 2>&1; then
  echo "Installing node..."
  mkdir -p bin
  curl -fsSL https://nodejs.org/dist/v22.14.0/node-v22.14.0-linux-x64.tar.xz -o /tmp/node.tar.xz
  tar -xf /tmp/node.tar.xz -C /tmp
  cp /tmp/node-v22.14.0-linux-x64/bin/node bin/node
  chmod +x bin/node
  export PATH="$PWD/bin:$PATH"
fi

python3 -m devverse
