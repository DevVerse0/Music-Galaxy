# ── Core Credentials ──
API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token
OWNER_ID=your_user_id
LOGGER_ID=-100your_logger_group_id

# ── Session Strings ──
SESSION1=your_session_string  # Assistant 1
SESSION2=your_session_string  # Assistant 2 (optional)
SESSION3=your_session_string  # Assistant 3 (optional)

# ── Server ──
PORT=8080
DATABASE_URL=database.db

# ── Database Backend ──
# Set DATABASE_MONGO=true to use MongoDB instead of SQLite (default)
# MONGO_URI is used when DATABASE_MONGO=true (append your DB name to the path)
DATABASE_MONGO=False
MONGO_URI=mongodb://localhost:27017

# ── Media ──
DURATION_LIMIT=60  # Max audio duration in minutes
QUEUE_LIMIT=20
PLAYLIST_LIMIT=20

# ── Features ──
AUTO_LEAVE=True
AUTO_END=True
THUMB_GEN=True
VIDEO_PLAY=True

# ── Content ──
COOKIES_URL=
DEFAULT_THUMB=https://graph.org/file/ed0d93790594a9d3bca7f-87677f2fe4e786509a.jpg
PING_IMG=https://files.catbox.moe/haagg2.png
START_IMG=https://graph.org/file/ed0d93790594a9d3bca7f-87677f2fe4e786509a.jpg

# ── Links ──
SUPPORT_CHANNEL=https://t.me/delete_tee7
SUPPORT_CHAT=https://t.me/+FHzwr_SeeJMwYjM1

# ── Dashboard ──
DASHBOARD_URL=
DASHBOARD_PASSWORD=your_password

# ── Download API (when yt-dlp is blocked, e.g. on Render) ──
# DOWNLOAD_API=true makes the bot download through DOWNLOAD_API_URL.
# Set DOWNLOAD_API=false to use the default yt-dlp downloader.
# Example (free, no key needed): https://ai-nextra.vercel.app/api/ytmp3
# RapidAPI example:
#   DOWNLOAD_API_URL=https://youtube-media-downloader.p.rapidapi.com/v2/video/details
#   DOWNLOAD_API_KEY=<your rapidapi key>
DOWNLOAD_API=False
DOWNLOAD_API_URL=
DOWNLOAD_API_KEY=

# ── Misc ──
MAINTENANCE=False
LANG_CODE=en
OWNER_USERNAME=@Delete_ee
